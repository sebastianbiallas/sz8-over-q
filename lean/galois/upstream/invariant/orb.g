g1 := (1,54,61)(2,18,10)(3,8,14)(4,9,40)(5,48,55)(6,35,21)(7,12,17)(11,13,25)(15,28,31)(19,53,37)(22,34,52)(23,43,46)(24,45,33)(26,42,29)(30,32,41)(36,44,49)(38,59,62)(39,47,65)(50,63,64)(51,57,60);
g2 := (1,60,55)(2,15,9)(3,11,19)(4,54,49)(5,41,8)(6,16,13)(7,20,34)(10,24,12)(14,30,29)(18,36,52)(22,47,42)(23,53,35)(25,32,44)(27,28,43)(31,40,33)(37,48,45)(38,64,46)(39,63,58)(50,61,56)(51,65,62);
G := Group(g1, g2); N := DerivedSubgroup(G);
act := function(x, g) return [x[1]^g, OnSets(x[2], g)]; end;
O := Orbit(N, [1, [2,4]], act);
out := OutputTextFile(OUT, false); SetPrintFormattingStatus(out, false);
for j in [0,1,2] do
  for x in O do
    y := act(x, g1^j);
    AppendTo(out, j, " ", y[1]-1, " ", y[2][1]-1, " ", y[2][2]-1, "\n");
  od;
od;
CloseStream(out);
QUIT;
