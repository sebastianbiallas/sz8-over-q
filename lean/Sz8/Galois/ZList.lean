import Sz8.Galois.PointBound

/-!
# The resolvent coefficients as coefficient lists

`aeval_Z`: the value of `Z1, Z2, Z3` at `t` is `PointBound.aevalList t (zl m)`.
-/

namespace Sz8.Galois.ZList

open Polynomial Resolvent PointBound

/-- The coefficient lists of `Z1, Z2, Z3`. -/
def zl : Fin 3 → List ℤ := ![
  [-165991526917847962656, -1030736663960201183232, -809010315674278428672],
  [-21909268199643117728975305214510621414400, 71587313281162573234267391081974644867072,
    59886972958579920338746919560722253873152, 203233104214748580421330208707901185327104,
    -123137336770786421082389940182577850613760],
  [-124086085315533064252521547874582047904229069277048776261632,
    -5181457959791320305532566000603783120138828861630415261138944,
    36629092934622288189551628243128327990462230306083682809544704,
    147194758257054669169301819655479691777958957228304486381912064,
    278458813396941187458756425713976469198157167540968064773259264,
    250347190608973277305961174801960214529169207333621575037485056,
    145836463183698207944280389026896446652806612428796352188645376]]

theorem aeval_Z (t : ℂ) (m : Fin 3) :
    Polynomial.aeval t (![Z1, Z2, Z3] m) = aevalList t (zl m) := by
  fin_cases m <;> simp [Z1, Z2, Z3, zl, aevalList, map_ofNat] <;> ring

end Sz8.Galois.ZList
