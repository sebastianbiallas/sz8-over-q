import Sz8.Monodromy.StepData
import Sz8.Galois.ResAlg
import Sz8.Galois.NodeData

/-!
# The evaluation core for the resultant identity

Everything the kernel computes at one integer point `t`:

* `fAsc t`: the coefficients of `f(·, t)` from the exact rational columns `originalColumns`;
* `dDesc t`, `fDesc t`: descending lists of `f(·, t)` and its derivative, for `ResAlg.res`;
* `rhsVal t = c̃ · (t² + t + 1)^40 · S̃(t)²` with `S̃` the integer node polynomial of
  `Sz8.Galois.NodeData` and `c̃ = c / κ²` absorbing the normalisation `S̃ = κ S`;
* `evalOK t`: the Boolean the kernel decides.

This file is deliberately light: the evaluation batches import only it.
-/

namespace Sz8.Galois.ResEval

open Sz8.Monodromy ResAlg NodeData

/-- Coefficient `i` of `f(·, t)`: `∑ⱼ column_j[i] tʲ` by Horner in `t`. -/
def colCoeff (t : ℚ) (i : ℕ) : ℚ := originalColumns.foldr (fun col acc => col.getD i 0 + t * acc) 0

/-- Ascending coefficients of `f(·, t)`. -/
def fAsc (t : ℚ) : List ℚ := (List.range 66).map (colCoeff t)

def derivAux : ℕ → List ℚ → List ℚ
  | _, [] => []
  | k, a :: as => ((k : ℕ) : ℚ) * a :: derivAux (k + 1) as

/-- Derivative, ascending coefficients. -/
def derivAsc : List ℚ → List ℚ
  | [] => []
  | _ :: as => derivAux 1 as

def fDesc (t : ℚ) : List ℚ := (fAsc t).reverse

def dDesc (t : ℚ) : List ℚ := (derivAsc (fAsc t)).reverse

def horner (l : List ℚ) (x : ℚ) : ℚ := l.foldr (fun a acc => a + x * acc) 0

/-- `c̃ = c / κ²`. -/
def ctil : ℚ :=  / 

def rhsVal (t : ℚ) : ℚ := ctil * (t * t + t + 1) ^ 40 * horner (Slist.map (fun a : ℤ => (a : ℚ))) t ^ 2

/-- The kernel's check at one point. -/
def evalOK (t : ℚ) : Bool := res 70 (fDesc t) (dDesc t) == rhsVal t

end Sz8.Galois.ResEval
